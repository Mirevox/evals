# Mirevox evals — copy to .env for local/Docker overrides
# Zero-key default: leave secrets blank and use MockJudge.

PORT=3847

# Persistence: json-file (default, Docker volume at /app/data) | memory (tests only)
EVALS_STORE=json-file
EVALS_DATA_DIR=./data

# Optional bearer for POST /api/capture/* (omit for open local capture)
# EVALS_CAPTURE_TOKEN=change-me

# Optional LLM-as-judge via OpenRouter (falls back to MockJudge when unset/failing)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini
